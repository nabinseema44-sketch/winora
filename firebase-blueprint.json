{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Secure authenticated player profile document in users/{uid}",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Authentication UID matching document ID" },
        "phoneNumber": { "type": "string", "description": "Verified mobile phone number in E.164 format" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 50, "description": "Player display nickname" },
        "role": { "type": "string", "enum": ["player"], "description": "Player security role. Default and strictly locked to 'player'." },
        "status": { "type": "string", "enum": ["active"], "description": "Account operational status. Default and locked to 'active'." },
        "avatar": { "type": "string", "maxLength": 300, "description": "Optional player avatar URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "ISO timestamp of account creation (immutable)" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "ISO timestamp of last profile update" }
      },
      "required": ["uid", "phoneNumber", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "User account money wallet document in wallets/{uid}. Balance is strictly server-authoritative and non-writable by clients.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User unique ID matching document ID" },
        "currency": { "type": "string", "description": "Currency code (e.g. INR, USD)" },
        "balance": { "type": "number", "minimum": 0, "description": "Available money balance. Updated solely by server." },
        "heldBalance": { "type": "number", "minimum": 0, "description": "Funds temporarily held for pending withdrawals." },
        "kycStatus": { "type": "string", "enum": ["not_submitted", "pending", "verified", "rejected"], "description": "KYC compliance state." },
        "withdrawalEligibility": { "type": "boolean", "description": "Whether user is legally eligible to withdraw." },
        "accountVerificationStatus": { "type": "string", "enum": ["unverified", "verified", "restricted"], "description": "Financial verification status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "ISO timestamp of wallet creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "ISO timestamp of last update" }
      },
      "required": ["uid", "currency", "balance", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record in transactions/{transactionId}. Non-writable by client.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string", "description": "Unique transaction identifier" },
        "uid": { "type": "string", "description": "User UID who owns the transaction" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal"], "description": "Transaction direction" },
        "amount": { "type": "number", "minimum": 0.01, "description": "Transaction amount" },
        "currency": { "type": "string", "description": "Currency code (e.g. INR)" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed", "cancelled"], "description": "Lifecycle status" },
        "paymentMethod": { "type": "string", "description": "Payment channel (UPI, Card, NetBanking, IMPS)" },
        "providerReference": { "type": "string", "description": "External payment gateway order/UTR reference" },
        "idempotencyKey": { "type": "string", "description": "Unique key preventing duplicate processing" },
        "destinationAccount": { "type": "string", "description": "Masked destination bank account or VPA" },
        "createdAt": { "type": "string", "format": "date-time", "description": "ISO timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "ISO timestamp of last status update" }
      },
      "required": ["transactionId", "uid", "type", "amount", "currency", "status", "paymentMethod", "providerReference", "createdAt", "updatedAt"]
    },
    "WalletAudit": {
      "title": "WalletAudit",
      "description": "Immutable balance audit log in wallet_audits/{auditId}. Strictly server-generated.",
      "type": "object",
      "properties": {
        "auditId": { "type": "string", "description": "Unique audit record ID" },
        "uid": { "type": "string", "description": "User identifier" },
        "transactionId": { "type": "string", "description": "Associated transaction ID" },
        "operation": { "type": "string", "enum": ["deposit_credit", "withdrawal_hold", "withdrawal_debit", "withdrawal_release_failed"], "description": "Mutation type" },
        "amount": { "type": "number", "description": "Amount mutated" },
        "previousBalance": { "type": "number", "description": "Balance prior to mutation" },
        "newBalance": { "type": "number", "description": "Balance following mutation" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Timestamp of mutation" },
        "sourceReference": { "type": "string", "description": "Server-side webhook/settlement reference" }
      },
      "required": ["auditId", "uid", "transactionId", "operation", "amount", "previousBalance", "newBalance", "timestamp", "sourceReference"]
    },
    "GameResult": {
      "title": "GameResult",
      "description": "Server-authoritative winning number declaration and settlement record in gameResults/{resultId}. Non-writable by client.",
      "type": "object",
      "properties": {
        "resultId": { "type": "string", "description": "Unique result identifier" },
        "gameId": { "type": "string", "description": "Identifier of the game (e.g. game_x, hourly_dhamaka)" },
        "roundId": { "type": "string", "description": "Identifier of the settled round" },
        "winningNumber": { "type": "string", "description": "Exact two-digit winning number string ('00'-'99')" },
        "declaredBy": { "type": "string", "description": "Master actor ID who confirmed declaration" },
        "declaredAt": { "type": "string", "format": "date-time", "description": "Timestamp of declaration" },
        "ruleVersion": { "type": "string", "description": "Settlement engine rule version" },
        "status": { "type": "string", "enum": ["PROCESSING", "COMPLETED", "FAILED"], "description": "Lifecycle status" },
        "settlementId": { "type": "string", "description": "Unique settlement transaction ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of record creation" }
      },
      "required": ["resultId", "gameId", "roundId", "winningNumber", "declaredBy", "declaredAt", "ruleVersion", "status", "settlementId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Player profile document. Readable and writable only by the authenticated owner user. Role, status, and UID are immutable."
    },
    "/wallets/{userId}": {
      "schema": "Wallet",
      "description": "Money wallet document. Read-only by owner user. Balance and transactions are strictly non-writable by client."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Audit-logged financial transactions. Read-only by owner user. Non-writable by client."
    },
    "/wallet_audits/{auditId}": {
      "schema": "WalletAudit",
      "description": "Immutable financial audit records. Read-only by owner user. Non-writable by client."
    },
    "/gameResults/{resultId}": {
      "schema": "GameResult",
      "description": "Publicly readable round result and settlement audit record. Non-writable by client."
    }
  }
}
