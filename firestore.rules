rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null && request.auth.uid != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidDisplayName(name) { return name is string && name.size() >= 2 && name.size() <= 50; }
    function isValidNewUser(userId, data) {
      return data.uid == userId && data.role == 'player' && data.status == 'active'
        && isValidDisplayName(data.displayName) && data.phoneNumber is string
        && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 20
        && (data.createdAt is string || data.createdAt is timestamp)
        && (data.updatedAt is string || data.updatedAt is timestamp)
        && data.keys().hasAll(['uid','phoneNumber','displayName','role','status','createdAt','updatedAt'])
        && !data.keys().hasAny(['password','pass','hash','salt','otp','code','token','isAdmin','admin','permissions','referredByUserId','referrerUserId','referralRewardAmount','walletBalance','balance','heldBalance']);
    }

    match /{document=**} { allow read, write: if false; }
    match /_system/connectionTest { allow read: if true; allow write: if false; }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidNewUser(userId, incoming());
      allow update: if isOwner(userId) && isValidId(userId)
        && incoming().uid == existing().uid && incoming().role == existing().role
        && incoming().status == existing().status && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName','updatedAt','avatar'])
        && (!incoming().diff(existing()).affectedKeys().hasAny(['displayName']) || isValidDisplayName(incoming().displayName))
        && !incoming().keys().hasAny(['password','pass','hash','salt','otp','code','token','isAdmin','admin','permissions']);
      allow delete: if false;
    }

    match /wallets/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Collection-wide listing is intentionally denied. User history is served by authenticated server APIs.
    match /transactions/{transactionId} {
      allow get: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /wallet_audits/{auditId} {
      allow get: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /system/paymentConfig {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /gameResults/{resultId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /referrals/{referralId} {
      allow get: if isAuthenticated() && (resource.data.referrerUserId == request.auth.uid || resource.data.referredUserId == request.auth.uid);
      // Deny list to prevent cross-user referral enumeration; use the authenticated server API.
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
